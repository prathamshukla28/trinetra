{
  "name": "@prathamshukla28/trinetra",
  "version": "0.1.0",
  "description": "The third eye for software — reverse-engineer, audit, and rebuild any app or binary with agents.",
  "type": "module",
  "bin": {
    "trinetra": "src/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "demo": "node src/cli.js teardown targets/sample-cli",
    "demo:asar": "asar pack examples/demo-electron-app targets/demo-app.asar && node src/cli.js teardown targets/demo-app.asar",
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "keywords": [
    "reverse-engineering",
    "security",
    "static-analysis",
    "decompiler",
    "ghidra",
    "semgrep",
    "binary-analysis",
    "agents",
    "cli"
  ],
  "author": "Pratham Shukla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prathamshukla28/trinetra.git"
  },
  "bugs": {
    "url": "https://github.com/prathamshukla28/trinetra/issues"
  },
  "homepage": "https://github.com/prathamshukla28/trinetra#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "rea-agents": "^6.8.0"
  }
}
