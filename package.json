{
  "name": "@prathamshukla28/trinetra",
  "version": "0.1.0",
  "description": "Reverse-engineer, audit, and rebuild apps and binaries: own AST/taint and binary-hardening analysis, orchestrating REA (Ghidra) and Semgrep.",
  "type": "module",
  "bin": {
    "trinetra": "src/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "trinetra.config.example.json"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "demo": "node src/cli.js teardown examples/sample-cli",
    "demo:asar": "asar pack examples/demo-electron-app trinetra-out/demo-app.asar && node src/cli.js teardown trinetra-out/demo-app.asar",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "bench": "node bench/fetch-corpus.mjs && node bench/run.mjs",
    "prepublishOnly": "npm run lint && node --test test/*.test.js"
  },
  "keywords": [
    "reverse-engineering",
    "security",
    "static-analysis",
    "decompiler",
    "ghidra",
    "semgrep",
    "binary-analysis",
    "agents",
    "cli"
  ],
  "author": "Pratham Shukla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prathamshukla28/trinetra.git"
  },
  "bugs": {
    "url": "https://github.com/prathamshukla28/trinetra/issues"
  },
  "homepage": "https://github.com/prathamshukla28/trinetra#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.2",
    "rea-agents": "^6.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10"
  }
}
